{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duong Sinh Chess Studio",
  "version": "0.1.0",
  "identifier": "vn.duongsinh.chessstudio",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Dương Sinh Chess Studio",
        "url": "index.html",
        "width": 440,
        "height": 280,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/typstify-server", "binaries/typst", "binaries/tinymist"],
    "resources": {
      "resources/web/": "web/",
      "resources/packages/": "packages/"
    },
    "windows": {
      "nsis": {
        "languages": ["Vietnamese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
